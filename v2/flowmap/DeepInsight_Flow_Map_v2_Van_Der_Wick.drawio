="n198" value="" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeWidth=2.4;strokeColor=#2ca02c;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="5520.0" y="645.0" as="sourcePoint"/><mxPoint x="5799.0" y="575.0" as="targetPoint"/><Array as="points"><mxPoint x="5532.0" y="645.0"/><mxPoint x="5532.0" y="175.0"/><mxPoint x="5799.0" y="175.0"/></Array></mxGeometry></mxCell><mxCell id="n199" value="38. 5.2→4: L-total vs batas kritis dikirim" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#2ca02c;fillColor=#FFFFFF;strokeColor=#2ca02c;rounded=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="5544.0" y="159.0" width="243.0" height="30.0" as="geometry"/></mxCell><mxCell id="n200" value="" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeWidth=2.4;strokeColor=#9467bd;dashed=1;dashPattern=8 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="5520.0" y="675.0" as="sourcePoint"/><mxPoint x="236.0" y="857.0" as="targetPoint"/><Array as="points"><mxPoint x="5548.0" y="675.0"/><mxPoint x="5548.0" y="1317.0"/><mxPoint x="236.0" y="1317.0"/></Array></mxGeometry></mxCell><mxCell id="n201" value="39. 5.2→3: Ukur ulang segmen" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#9467bd;fillColor=#FFFFFF;strokeColor=#9467bd;rounded=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="2797.6" y="1301.0" width="188.8" height="30.0" as="geometry"/></mxCell><mxCell id="n202" value="" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeWidth=2.4;strokeColor=#ff7f0e;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="5882.0" y="645.0" as="sourcePoint"/><mxPoint x="6090.0" y="575.0" as="targetPoint"/><Array as="points"><mxPoint x="5894.0" y="645.0"/><mxPoint x="5894.0" y="175.0"/><mxPoint x="6090.0" y="175.0"/></Array></mxGeometry></mxCell><mxCell id="n203" value="40. 4→6: Temuan masuk laporan" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#ff7f0e;fillColor=#FFFFFF;strokeColor=#ff7f0e;rounded=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="5906.0" y="159.0" width="172.0" height="30.0" as="geometry"/></mxCell><mxCell id="n204" value="" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeWidth=2.4;strokeColor=#17becf;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="6228.0" y="645.0" as="sourcePoint"/><mxPoint x="6472.7" y="575.0" as="targetPoint"/><Array as="points"><mxPoint x="6240.0" y="645.0"/><mxPoint x="6240.0" y="175.0"/><mxPoint x="6472.7" y="175.0"/></Array></mxGeometry></mxCell><mxCell id="n205" value="41. 6→12: Laporan disetujui, tutup sesi" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#17becf;fillColor=#FFFFFF;strokeColor=#17becf;rounded=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="6252.0" y="159.0" width="208.7" height="30.0" as="geometry"/></mxCell><mxCell id="n206" value="" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeWidth=2.4;strokeColor=#8c564b;dashed=1;dashPattern=8 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="6574.0" y="645.0" as="sourcePoint"/><mxPoint x="258.0" y="857.0" as="targetPoint"/><Array as="points"><mxPoint x="6586.0" y="645.0"/><mxPoint x="6586.0" y="1357.0"/><mxPoint x="258.0" y="1357.0"/></Array></mxGeometry></mxCell><mxCell id="n207" value="42. 12→3: Sesi baru dimulai dari Optical" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#8c564b;fillColor=#FFFFFF;strokeColor=#8c564b;rounded=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="3291.0" y="1341.0" width="262.0" height="30.0" as="geometry"/></mxCell><mxCell id="n208" value="▲ Jalur atas: alur maju (garis utuh)" style="text;html=1;whiteSpace=wrap;fontSize=11;fontStyle=1;fontColor=#2E7D32;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="123.0" width="420.0" height="20.0" as="geometry"/></mxCell><mxCell id="n209" value="▼ Jalur bawah: kembali / ulang (garis putus-putus)" style="text;html=1;whiteSpace=wrap;fontSize=11;fontStyle=1;fontColor=#C0392B;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="870.0" width="460.0" height="18.0" as="geometry"/></mxCell><mxCell id="n210" value="&lt;b&gt;Cara membaca&lt;/b&gt;&lt;br&gt;• Hanya satu window fitur (AquaClear / HydroDetect / SpatialSight) aktif; setiap perpindahan lewat dialog 3.0 yang melepas model sebelumnya.&lt;br&gt;• FREEZE dari window mana pun membuka Mode Snapshot; kalibrasi dan titik ukur berlaku untuk frame itu saja.&lt;br&gt;• Garis putus-putus = kembali/ulang karena pemeriksaan gagal atau operator memilih kembali.&lt;br&gt;• Warna garis berbeda-beda; label berbingkai = proses yang terjadi pada perpindahan tersebut." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF7D6;strokeColor=#E3C766;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40.0" y="1437.0" width="1500.0" height="118.0" as="geometry"/></mxCell><mxCell id="n211" value="&lt;b&gt;Daftar garis (nomor = label di diagram)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#12355F;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="1585.0" width="900.0" height="28.0" as="geometry"/></mxCell><mxCell id="n212" value="&lt;span style='color:#1f77b4'&gt;■&lt;/span&gt; &lt;b&gt;1&lt;/b&gt;  3 → 3.0  ·  hotspot “Tab AquaClear”  ·  Minta buka AquaClear" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="1619.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n213" value="&lt;span style='color:#d62728'&gt;■&lt;/span&gt; &lt;b&gt;2&lt;/b&gt;  3 → 3.0  ·  hotspot “Tab HydroDetect”  ·  Minta buka HydroDetect" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="1649.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n214" value="&lt;span style='color:#2ca02c'&gt;■&lt;/span&gt; &lt;b&gt;3&lt;/b&gt;  3 → 3.0  ·  hotspot “Tab SpatialSight”  ·  Minta buka SpatialSight" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="1679.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n215" value="&lt;span style='color:#9467bd'&gt;■&lt;/span&gt; &lt;b&gt;4&lt;/b&gt;  3 → 3.4  ·  hotspot “Tab Canvas”  ·  Buka anotasi &amp;amp; kolaborasi" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="1709.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n216" value="&lt;span style='color:#ff7f0e'&gt;■&lt;/span&gt; &lt;b&gt;5&lt;/b&gt;  3 → 3.5  ·  hotspot “FREEZE”  ·  Kunci frame + frame ID" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="1739.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n217" value="&lt;span style='color:#17becf'&gt;■&lt;/span&gt; &lt;b&gt;6&lt;/b&gt;  3 → 4  ·  hotspot “Tandai temuan”  ·  Kandidat dikirim ke review" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="1769.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n218" value="&lt;span style='color:#8c564b'&gt;■&lt;/span&gt; &lt;b&gt;7&lt;/b&gt;  3 → 12  ·  hotspot “Selesai sesi”  ·  Hentikan rekaman" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="1799.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n219" value="&lt;span style='color:#e377c2'&gt;■&lt;/span&gt; &lt;b&gt;8&lt;/b&gt;  3.0 → 3.1  ·  hotspot “AquaClear dipilih”  ·  Lepas model lama, muat preset" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="1829.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n220" value="&lt;span style='color:#7f7f00'&gt;■&lt;/span&gt; &lt;b&gt;9&lt;/b&gt;  3.0 → 3.2  ·  hotspot “HydroDetect dipilih”  ·  Lepas model lama, muat exp-5" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="1859.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n221" value="&lt;span style='color:#0b3d91'&gt;■&lt;/span&gt; &lt;b&gt;10&lt;/b&gt;  3.0 → 3.3  ·  hotspot “SpatialSight dipilih”  ·  Lepas model lama, muat model kedalaman" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="1889.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n222" value="&lt;span style='color:#006d5b'&gt;■&lt;/span&gt; &lt;b&gt;11&lt;/b&gt;  3.0 → 3  ·  hotspot “Batal”  ·  Tetap di Optical  (kembali/ulang)" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="1919.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n223" value="&lt;span style='color:#c71585'&gt;■&lt;/span&gt; &lt;b&gt;12&lt;/b&gt;  3.1 → 3.5  ·  hotspot “Kunci preset”  ·  FREEZE dengan preset terca