okeColor=#cd5c5c;rounded=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="3631.9" y="159.0" width="188.8" height="30.0" as="geometry"/></mxCell><mxCell id="n132" value="" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeWidth=2.4;strokeColor=#20b2aa;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3944.0" y="805.0" as="sourcePoint"/><mxPoint x="4880.7" y="735.0" as="targetPoint"/><Array as="points"><mxPoint x="3956.0" y="805.0"/><mxPoint x="3956.0" y="175.0"/><mxPoint x="4880.7" y="175.0"/></Array></mxGeometry></mxCell><mxCell id="n133" value="22. 7→10: Paket bukti diarsipkan" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#20b2aa;fillColor=#FFFFFF;strokeColor=#20b2aa;rounded=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="4311.7" y="159.0" width="213.2" height="30.0" as="geometry"/></mxCell><mxCell id="n134" value="" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeWidth=2.4;strokeColor=#9932cc;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="4290.0" y="805.0" as="sourcePoint"/><mxPoint x="5226.7" y="735.0" as="targetPoint"/><Array as="points"><mxPoint x="4302.0" y="805.0"/><mxPoint x="4302.0" y="215.0"/><mxPoint x="5226.7" y="215.0"/></Array></mxGeometry></mxCell><mxCell id="n135" value="23. 8→11: Versi model diaktifkan" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#9932cc;fillColor=#FFFFFF;strokeColor=#9932cc;rounded=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="4657.7" y="199.0" width="213.2" height="30.0" as="geometry"/></mxCell><mxCell id="n136" value="" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeWidth=2.4;strokeColor=#228b22;dashed=1;dashPattern=8 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="4636.0" y="805.0" as="sourcePoint"/><mxPoint x="2076.0" y="837.0" as="targetPoint"/><Array as="points"><mxPoint x="4648.0" y="805.0"/><mxPoint x="4648.0" y="1307.0"/><mxPoint x="2076.0" y="1307.0"/></Array></mxGeometry></mxCell><mxCell id="n137" value="24. 9→2: Telusuri KPI ke misi" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#228b22;fillColor=#FFFFFF;strokeColor=#228b22;rounded=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="3264.6" y="1291.0" width="194.9" height="30.0" as="geometry"/></mxCell><mxCell id="n138" value="" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeWidth=2.4;strokeColor=#ff1493;dashed=1;dashPattern=8 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="4982.0" y="805.0" as="sourcePoint"/><mxPoint x="3114.0" y="837.0" as="targetPoint"/><Array as="points"><mxPoint x="4994.0" y="805.0"/><mxPoint x="4994.0" y="1267.0"/><mxPoint x="3114.0" y="1267.0"/></Array></mxGeometry></mxCell><mxCell id="n139" value="25. 10→5: Lihat ulang bukti lama" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#ff1493;fillColor=#FFFFFF;strokeColor=#ff1493;rounded=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="3947.4" y="1251.0" width="213.2" height="30.0" as="geometry"/></mxCell><mxCell id="n140" value="" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeWidth=2.4;strokeColor=#4682b4;dashed=1;dashPattern=8 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="5328.0" y="805.0" as="sourcePoint"/><mxPoint x="1208.0" y="1167.0" as="targetPoint"/><Array as="points"><mxPoint x="5340.0" y="805.0"/><mxPoint x="5340.0" y="1347.0"/><mxPoint x="1208.0" y="1347.0"/></Array></mxGeometry></mxCell><mxCell id="n141" value="26. 11→SB: Konfigurasi tercatat di audit log" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#4682b4;fillColor=#FFFFFF;strokeColor=#4682b4;rounded=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="3130.8" y="1331.0" width="286.4" height="30.0" as="geometry"/></mxCell><mxCell id="n142" value="" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeWidth=2.4;strokeColor=#a0522d;dashed=1;dashPattern=8 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="5674.0" y="805.0" as="sourcePoint"/><mxPoint x="516.0" y="837.0" as="targetPoint"/><Array as="points"><mxPoint x="5686.0" y="805.0"/><mxPoint x="5686.0" y="1387.0"/><mxPoint x="516.0" y="1387.0"/></Array></mxGeometry></mxCell><mxCell id="n143" value="27. 12→0.1: Sesi baru" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#a0522d;fillColor=#FFFFFF;strokeColor=#a0522d;rounded=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="3027.9" y="1371.0" width="146.1" height="30.0" as="geometry"/></mxCell><mxCell id="n144" value="▲ Jalur atas: alur maju (garis utuh)" style="text;html=1;whiteSpace=wrap;fontSize=11;fontStyle=1;fontColor=#2E7D32;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="123.0" width="420.0" height="20.0" as="geometry"/></mxCell><mxCell id="n145" value="▼ Jalur bawah: kembali / ulang (garis putus-putus)" style="text;html=1;whiteSpace=wrap;fontSize=11;fontStyle=1;fontColor=#C0392B;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="1180.0" width="460.0" height="18.0" as="geometry"/></mxCell><mxCell id="n146" value="&lt;b&gt;Cara membaca&lt;/b&gt;&lt;br&gt;• Titik ungu di tepi kanan layar = hotspot yang diklik; nomor garis sama dengan Daftar garis di bawah.&lt;br&gt;• Garis utuh di atas = alur maju; garis putus-putus di bawah = kembali ke layar sebelumnya.&lt;br&gt;• Setiap garis memiliki warna sendiri; label berbingkai menjelaskan proses yang terjadi saat berpindah layar." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF7D6;strokeColor=#E3C766;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40.0" y="1467.0" width="1500.0" height="96.0" as="geometry"/></mxCell><mxCell id="n147" value="&lt;b&gt;Daftar garis (nomor = label di diagram)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#12355F;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="1593.0" width="900.0" height="28.0" as="geometry"/></mxCell><mxCell id="n148" value="&lt;span style='color:#1f77b4'&gt;■&lt;/span&gt; &lt;b&gt;1&lt;/b&gt;  0 → 0.1  ·  hotspot “Sistem siap”  ·  GPU, ruang simpan, jam tersinkron OK" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="1627.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n149" value="&lt;span style='color:#d62728'&gt;■&lt;/span&gt; &lt;b&gt;2&lt;/b&gt;  0.1 → 0.2  ·  hotspot “Masuk”  ·  Verifikasi akun (SSO/PIN)" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="1657.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n150" value="&lt;span style='color:#2ca02c'&gt;■&lt;/span&gt; &lt;b&gt;3&lt;/b&gt;  0.2 → SB  ·  hotspot “Lanjut”  ·  Hak akses sesuai peran dimuat" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="1687.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n151" value="&lt;span style='color:#9467bd'&gt;■&lt;/span&gt; &lt;b&gt;4&lt;/b&gt;  SB → 1  ·  hotspot “Dashboard”  ·  Lihat ringkasan misi &amp;amp; KPI" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="1717.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n152" value="&lt;span style='color:#ff7f0e'&gt;■&lt;/span&gt; &lt;b&gt;5&lt;/b&gt;  SB → 2  ·  hotspot “Misi”  ·  Kelola &amp;amp; rencanakan misi" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="1747.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n153" value="&lt;span style='color:#17becf'&gt;■&lt;/span&gt; &lt;b&gt;6&lt;/b&gt;  SB → 3  ·  hotspot “Live Operation”  ·  Operasi drone &amp;amp; rekam bukti" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="1777.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n154" value="&lt;span style='color:#8c564b'&gt;■&lt;/span&gt; &lt;b&gt;7&lt;/b&gt;  SB → 4  ·  hotspot “Review”  ·  Putuskan kandidat temuan" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="1807.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n155" value="&lt;span style='color:#e377c2'&gt;■&lt;/span&gt; &lt;b&gt;8&lt;/b&gt;  SB → 5  ·  hotspot “Gallery”  ·  Buka snapshot &amp;amp; ukuran" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="1837.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n156" value="&lt;span style='color:#7f7f00'&gt;■&lt;/span&gt; &lt;b&gt;9&lt;/b&gt;  SB → 6  ·  hotspot “Laporan”  ·  Susun &amp;amp; setujui laporan" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="1867.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n157" value="&lt;span style='color:#0b3d91'&gt;■&lt;/span&gt; &lt;b&gt;10&lt;/b&gt;  SB → 7  ·  hotspot “PIMS / RBI”  ·  Perbarui risiko &amp