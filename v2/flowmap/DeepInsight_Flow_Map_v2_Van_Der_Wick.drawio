spacing=2;" vertex="1" parent="1"><mxGeometry x="1748.0" y="159.0" width="172.0" height="30.0" as="geometry"/></mxCell><mxCell id="n80" value="" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeWidth=2.4;strokeColor=#e377c2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2070.0" y="365.0" as="sourcePoint"/><mxPoint x="2278.0" y="295.0" as="targetPoint"/><Array as="points"><mxPoint x="2082.0" y="365.0"/><mxPoint x="2082.0" y="175.0"/><mxPoint x="2278.0" y="175.0"/></Array></mxGeometry></mxCell><mxCell id="n81" value="8. F4→G4: Dua freeze per segmen" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#e377c2;fillColor=#FFFFFF;strokeColor=#e377c2;rounded=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="2094.0" y="159.0" width="172.0" height="30.0" as="geometry"/></mxCell><mxCell id="n82" value="" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeWidth=2.4;strokeColor=#7f7f00;dashed=1;dashPattern=8 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2416.0" y="365.0" as="sourcePoint"/><mxPoint x="1877.0" y="397.0" as="targetPoint"/><Array as="points"><mxPoint x="2428.0" y="365.0"/><mxPoint x="2428.0" y="557.0"/><mxPoint x="1877.0" y="557.0"/></Array></mxGeometry></mxCell><mxCell id="n83" value="9. G4→F4: Freeze ulang segmen" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#7f7f00;fillColor=#FFFFFF;strokeColor=#7f7f00;rounded=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="2055.1" y="541.0" width="194.9" height="30.0" as="geometry"/></mxCell><mxCell id="n84" value="" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeWidth=2.4;strokeColor=#0b3d91;dashed=1;dashPattern=8 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2416.0" y="395.0" as="sourcePoint"/><mxPoint x="1932.0" y="397.0" as="targetPoint"/><Array as="points"><mxPoint x="2444.0" y="395.0"/><mxPoint x="2444.0" y="517.0"/><mxPoint x="1932.0" y="517.0"/></Array></mxGeometry></mxCell><mxCell id="n85" value="10. G4→F4: Segmen berikut, patokan baru" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#0b3d91;fillColor=#FFFFFF;strokeColor=#0b3d91;rounded=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="2060.1" y="501.0" width="255.9" height="30.0" as="geometry"/></mxCell><mxCell id="n86" value="" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeWidth=2.4;strokeColor=#006d5b;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2416.0" y="425.0" as="sourcePoint"/><mxPoint x="2656.0" y="295.0" as="targetPoint"/><Array as="points"><mxPoint x="2460.0" y="425.0"/><mxPoint x="2460.0" y="175.0"/><mxPoint x="2656.0" y="175.0"/></Array></mxGeometry></mxCell><mxCell id="n87" value="11. G4→F6: Semua segmen sah" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#006d5b;fillColor=#FFFFFF;strokeColor=#006d5b;rounded=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="2472.0" y="159.0" width="172.0" height="30.0" as="geometry"/></mxCell><mxCell id="n88" value="" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeWidth=2.4;strokeColor=#c71585;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2794.0" y="365.0" as="sourcePoint"/><mxPoint x="3002.0" y="295.0" as="targetPoint"/><Array as="points"><mxPoint x="2806.0" y="365.0"/><mxPoint x="2806.0" y="175.0"/><mxPoint x="3002.0" y="175.0"/></Array></mxGeometry></mxCell><mxCell id="n89" value="12. F6→G6: L-kiri, L-kanan, L-total" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#c71585;fillColor=#FFFFFF;strokeColor=#c71585;rounded=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="2818.0" y="159.0" width="172.0" height="30.0" as="geometry"/></mxCell><mxCell id="n90" value="" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeWidth=2.4;strokeColor=#b8860b;dashed=1;dashPattern=8 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3140.0" y="365.0" as="sourcePoint"/><mxPoint x="1987.0" y="397.0" as="targetPoint"/><Array as="points"><mxPoint x="3152.0" y="365.0"/><mxPoint x="3152.0" y="597.0"/><mxPoint x="1987.0" y="597.0"/></Array></mxGeometry></mxCell><mxCell id="n91" value="13. G6→F4: Ukur ulang segmen selisih" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#b8860b;fillColor=#FFFFFF;strokeColor=#b8860b;rounded=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="2450.7" y="581.0" width="237.6" height="30.0" as="geometry"/></mxCell><mxCell id="n92" value="" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeWidth=2.4;strokeColor=#2f4f4f;dashed=1;dashPattern=8 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3140.0" y="395.0" as="sourcePoint"/><mxPoint x="170.0" y="397.0" as="targetPoint"/><Array as="points"><mxPoint x="3168.0" y="395.0"/><mxPoint x="3168.0" y="637.0"/><mxPoint x="170.0" y="637.0"/></Array></mxGeometry></mxCell><mxCell id="n93" value="14. G6→K: Kalibrasi ulang, ukur besok" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#2f4f4f;fillColor=#FFFFFF;strokeColor=#2f4f4f;rounded=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="1547.2" y="621.0" width="243.7" height="30.0" as="geometry"/></mxCell><mxCell id="n94" value="" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeWidth=2.4;strokeColor=#6a0dad;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3140.0" y="425.0" as="sourcePoint"/><mxPoint x="3380.0" y="295.0" as="targetPoint"/><Array as="points"><mxPoint x="3184.0" y="425.0"/><mxPoint x="3184.0" y="175.0"/><mxPoint x="3380.0" y="175.0"/></Array></mxGeometry></mxCell><mxCell id="n95" value="15. G6→F7: Angka hari ini sah" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#6a0dad;fillColor=#FFFFFF;strokeColor=#6a0dad;rounded=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="3196.0" y="159.0" width="172.0" height="30.0" as="geometry"/></mxCell><mxCell id="n96" value="" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeWidth=2.4;strokeColor=#d2691e;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3518.0" y="365.0" as="sourcePoint"/><mxPoint x="3726.0" y="295.0" as="targetPoint"/><Array as="points"><mxPoint x="3530.0" y="365.0"/><mxPoint x="3530.0" y="175.0"/><mxPoint x="3726.0" y="175.0"/></Array></mxGeometry></mxCell><mxCell id="n97" value="16. F7→G7: 16&amp;quot; 9,65 m / 8&amp;quot; 5,32 m" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#d2691e;fillColor=#FFFFFF;strokeColor=#d2691e;rounded=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="3542.0" y="159.0" width="172.0" height="30.0" as="geometry"/></mxCell><mxCell id="n98" value="" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeWidth=2.4;strokeColor=#008b8b;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3864.0" y="365.0" as="sourcePoint"/><mxPoint x="4051.3" y="295.0" as="targetPoint"/><Array as="points"><mxPoint x="3876.0" y="365.0"/><mxPoint x="3876.0" y="175.0"/><mxPoint x="4051.3" y="175.0"/></Array></mxGeometry></mxCell><mxCell id="n99" value="17. G7→END: Laporan + kajian FEA + perbaikan penopang" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#008b8b;fillColor=#FFFFFF;strokeColor=#008b8b;rounded=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="3888.0" y="159.0" width="151.3" height="30.0" as="geometry"/></mxCell><mxCell id="n100" value="" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeWidth=2.4;strokeColor=#8b0000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3864.0" y="395.0" as="sourcePoint"/><mxPoint x="4124.7" y="295.0" as="targetPoint"/><Array as="points"><mxPoint x="3892.0" y="395.0"/><mxPoint x="3892.0" y="215.0"/><mxPoint x="4124.7" y="215.0"/></Array></mxGeometry></mxCell><mxCell id="n101" value="18. G7→END: Laporan + survei ulang 6 bulan" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#8b0000;fillColor=#FFFFFF;strokeColor=#8b0000;rounded=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="3904.0" y="199.0" width="208.7" height="30.0" as="geometry"/></mxCell><mxCell id="n102" value="" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeWidth=2.4;strokeColor=#556b2f;dashed=1;dashPattern=8 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="4226.0" y="365.0" as="sourcePoint"/><mxPoint x="225.0" y="397.0" as="targetPoint"/><Array as="points"><mxPoint x="4238.0" y="365.0"/><mxPoint x="4238.0" y="677.0"/><mxPoint x="225.0" y="677.0"/></Array></mxGeometry></mxCell><mxCell id="n103" value="19. END→K: Siklus berulang" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#556b2f;fillColor=#FFFFFF;strokeColor=#556b2f;rounded=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="2143.2" y="661.0" width="176.6" height="30.0" as="geometry"/></mxCell><mxCell id="n104" value="▲ Jalur atas: alur maju (garis utuh)" style="text;html=1;whiteSpace=wrap;fontSize=11;fontStyle=1;fontColor=#2E7D32;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="123.0" width="420.0" height="20.0" as="geometry"/></mxCell><mxCell id="n105" value="▼ Jalur bawah: kembali / ulang (garis putus-putus)" style="text;html=1;whiteSpace=wrap;fontSize=11;fontStyle=1;fontColor=#C0392B;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="470.0" width="460.0" height="18.0" as="geometry"/></mxCell><mxCell id="n106" value="&lt;b&gt;Cara membaca&lt;/b&gt;&lt;br&gt;• Fase hijau menyebut nomor layar yang dipakai (lihat halaman 1 dan 2).&lt;br&gt;• Pemeriksaan merah muda adalah gerbang: bila gagal, garis putus-putus kembali ke fase yang harus diulang.&lt;br&gt;• Setiap garis berwarna berbeda dengan label proses." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF7D6;strokeColor=#E3C766;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40.0" y="757.0" width="1500.0" height="96.0" as="geometry"/></mxCell><mxCell id="n107" value="&lt;b&gt;Daftar garis (nomor = label di diagram)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#12355F;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="883.0" width="900.0" height="28.0" as="geometry"/></mxCell><mxCell id="n108" value="&lt;span style='color:#1f77b4'&gt;■&lt;/span&gt; &lt;b&gt;1&lt;/b&gt;  K → GK  ·  hotspot “Briefing &amp;amp; kunci kamera (2.2, 2.3)”  ·  Uji batang 1 m + kalibrasi lensa" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="917.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n109" value="&lt;span style='color:#d62728'&gt;■&lt;/span&gt; &lt;b&gt;2&lt;/b&gt;  GK → K  ·  hotspot “Tidak”  ·  Cek laser, ulang kalibrasi  (kembali/ulang)" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="947.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n110" value="&lt;span style='color:#2ca02c'&gt;■&lt;/span&gt; &lt;b&gt;3&lt;/b&gt;  GK → F1  ·  hotspot “Ya”  ·  Boleh mendekati pipa" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="977.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n111" value="&lt;span style='color:#9467bd'&gt;■&lt;/span&gt; &lt;b&gt;4&lt;/b&gt;  F1 → F2  ·  hotspot “Peta kasar selesai”  ·  P0, G, PE, area keruh tercatat" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="1007.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n112" value="&lt;span style='color:#ff7f0e'&gt;■&lt;/span&gt; &lt;b&gt;5&lt;/b&gt;  F2 → G2  ·  hotspot “Preset diuji”  ·  Inspection vs balanced" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="1037.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n113" value="&lt;span style='color:#17becf'&gt;■&lt;/span&gt; &lt;b&gt;6&lt;/b&gt;  G2 → F2  ·  hotspot “Tidak”  ·  Dekatkan 0,5 m / tunggu jernih  (kembali/ulang)" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="1067.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n114" value="&lt;span style='color:#8c564b'&gt;■&lt;/span&gt; &lt;b&gt;7&lt;/b&gt;  G2 → F4  ·  hotspot “Ya”  ·  Kunci preset, susun stasiun" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="1097.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n115" value="&lt;span style='color:#e377c2'&gt;■&lt;/span&gt; &lt;b&gt;8&lt;/b&gt;  F4 → G4  ·  hotspot “Segmen tersimpan”  ·  Dua freeze per segmen" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="820.0" y="917.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n116" value="&lt;span style='color:#7f7f00'&gt;■&lt;/span&gt; &lt;b&gt;9&lt;/b&gt;  G4 → F4  ·  hotspot “Tidak cocok”  ·  Freeze ulang segmen  (kembali/ulang)" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="820.0" y="947.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n117" value="&lt;span style='color:#0b3d91'&gt;■&lt;/span&gt; &lt;b&gt;10&lt;/b&gt;  G4 → F4  ·  hotspot “Belum PE+2”  ·  Segmen berikut, patokan baru  (kembali/ulang)" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="820.0" y="977.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n118" value="&lt;span style='color:#006d5b'&gt;■&lt;/span&gt; &lt;b&gt;11&lt;/b&gt;  G4 → F6  ·  hotspot “Selesai”  ·  Semua segmen sah" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="820.0" y="1007.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n119" value="&lt;span style='color:#c71585'&gt;■&lt;/span&gt; &lt;b&gt;12&lt;/b&gt;  F6 → G6  ·  hotspot “Panjang tiap bagian”  ·  L-kiri, L-kanan, L-total" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="820.0" y="1037.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n120" value="&lt;span style='color:#b8860b'&gt;■&lt;/span&gt; &lt;b&gt;13&lt;/b&gt;  G6 → F4  ·  hotspot “Selisih tali”  ·  Ukur ulang segmen selisih  (kembali/ulang)" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="820.0" y="1067.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n121" value="&lt;span style='color:#2f4f4f'&gt;■&lt;/span&gt; &lt;b&gt;14&lt;/b&gt;  G6 → K  ·  hotspot “Uji sore gagal”  ·  Kalibrasi ulang, ukur besok  (kembali/ulang)" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="820.0" y="1097.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n122" value="&lt;span style='color:#6a0dad'&gt;■&lt;/span&gt; &lt;b&gt;15&lt;/b&gt;  G6 → F7  ·  hotspot “Lolos”  ·  Angka hari ini sah" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1600.0" y="917.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n123" value="&lt;span style='color:#d2691e'&gt;■&lt;/span&gt; &lt;b&gt;16&lt;/b&gt;  F7 → G7  ·  hotspot “Bandingkan batas kritis”  ·  16&amp;quot; 9,65 m / 8&amp;quot; 5,32 m" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1600.0" y="947.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n124" value="&lt;span style='color:#008b8b'&gt;■&lt;/span&gt; &lt;b&gt;17&lt;/b&gt;  G7 → END  ·  hotspot “Ya”  ·  Laporan + kajian FEA + perbaikan penopang" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1600.0" y="977.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n125" value="&lt;span style='color:#8b0000'&gt;■&lt;/span&gt; &lt;b&gt;18&lt;/b&gt;  G7 → END  ·  hotspot “Tidak”  ·  Laporan + survei ulang 6 bulan" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1B2B3A;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1600.0" y="1007.0" width="760.0" height="26.0" as="geometry"/></mxCell><mxCell id="n126" value="&lt;span sty